{
  "name": "sklentr-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for the Sklentr WordPress theme — Dart Sass compiles scss/ → assets/css/main.css.",
  "scripts": {
    "build": "sass scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "dev": "sass scss/main.scss assets/css/main.css --style=expanded --source-map",
    "watch": "sass --watch scss/main.scss assets/css/main.css --style=expanded --source-map"
  },
  "devDependencies": {
    "sass": "^1.83.0"
  }
}
